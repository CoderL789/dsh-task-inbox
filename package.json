{
  "name": "dsh-task-inbox",
  "version": "0.4.5",
  "description": "Session-decoupled task inbox for DeepSeek Harness: collect todos, then dispatch them to a workspace session for an Agent to execute.",
  "license": "MIT",
  "author": "DSH Task Inbox contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoderL789/dsh-task-inbox.git"
  },
  "bugs": {
    "url": "https://github.com/CoderL789/dsh-task-inbox/issues"
  },
  "homepage": "https://github.com/CoderL789/dsh-task-inbox#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "todo",
    "inbox",
    "task"
  ],
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/**/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/**/*.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node --check lib/host/index.js && node --check lib/client/index.js",
    "test": "node --test test/model.test.mjs test/service.test.mjs test/store.test.mjs test/api.test.mjs test/execution-context.test.mjs test/dispatch-plan.test.mjs test/execution-service.test.mjs test/client-dispatch.test.mjs test/http.integration.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
